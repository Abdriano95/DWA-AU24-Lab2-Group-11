@model DWA_AU24_Lab2_Group_11.Models.HarvestTracking

@{
    ViewData["Title"] = "Edit Harvest Tracking";
}

<h1 class="ft-page-title">
    <i class="bi bi-pencil-square"></i>Edit Harvest Tracking
</h1>

<div class="ft-crud-card">
    <form asp-action="Edit" class="ft-form">
        <div class="form-group mb-3">
            <label asp-for="PlantingScheduleId" class="form-label"></label>
            <select asp-for="PlantingScheduleId" class="form-select" asp-items="ViewBag.PlantingScheduleId"></select>
            <span asp-validation-for="PlantingScheduleId" class="text-danger"></span>
        </div>
        
        <div class="form-group mb-3">
            <label class="form-label">Harvest Status</label>
            @if (Model.HarvestDate.HasValue)
            {
                <div class="alert alert-success mb-0">
                    <i class="bi bi-check-circle me-2"></i>
                    Harvested on @Model.HarvestDate.Value.ToString("MMMM dd, yyyy 'at' h:mm tt")
                </div>
            }
            else
            {
                <div class="alert alert-warning mb-2">
                    <i class="bi bi-hourglass-split me-2"></i>Not harvested yet
                </div>
                <form asp-action="MarkAsHarvested" asp-route-id="@Model.Id" method="post" class="d-inline">
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-lg me-1"></i>Mark as Harvested
                    </button>
                </form>
            }
        </div>
        
        <div class="ft-form-actions">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-lg me-1"></i>Save Changes
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>Cancel
            </a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
