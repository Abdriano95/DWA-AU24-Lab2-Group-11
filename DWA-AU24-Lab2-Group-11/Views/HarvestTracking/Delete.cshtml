@model DWA_AU24_Lab2_Group_11.Models.HarvestTracking

@{
    ViewData["Title"] = "Delete Harvest";
}

<h1 class="ft-page-title">
    <i class="bi bi-trash"></i>Delete Harvest Tracking
</h1>

<div class="ft-delete-card">
    <p class="ft-delete-warning">
        <i class="bi bi-exclamation-triangle-fill"></i>
        Are you sure you want to delete this harvest tracking record? This action cannot be undone.
    </p>
    
    <dl class="ft-detail-list">
        <dt>Schedule ID</dt>
        <dd><span class="badge bg-secondary">#@Model.PlantingSchedule.Id</span></dd>
        
        <dt>Crop Name</dt>
        <dd><strong>@Model.PlantingSchedule.Crop?.Name</strong></dd>
        
        <dt>Planting Date</dt>
        <dd>@Model.PlantingSchedule.PlantingDate.ToString("MMMM dd, yyyy")</dd>
        
        <dt>Expected Harvest Date</dt>
        <dd>
            @if (Model.PlantingSchedule.ExpectedHarvestDate.HasValue)
            {
                @Model.PlantingSchedule.ExpectedHarvestDate.Value.ToString("MMMM dd, yyyy")
            }
            else
            {
                <span class="text-muted">—</span>
            }
        </dd>
        
        <dt>Harvest Status</dt>
        <dd>
            @if (Model.HarvestDate.HasValue)
            {
                <span class="badge bg-success">Harvested on @Model.HarvestDate.Value.ToString("MMM dd, yyyy")</span>
            }
            else
            {
                <span class="badge bg-warning text-dark">Not harvested yet</span>
            }
        </dd>
    </dl>
    
    <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
        <div class="ft-form-actions">
            <button type="submit" class="btn btn-danger">
                <i class="bi bi-trash me-1"></i>Delete Record
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>Cancel
            </a>
        </div>
    </form>
</div>
