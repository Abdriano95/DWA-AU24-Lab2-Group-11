@model DWA_AU24_Lab2_Group_11.Models.PlantingSchedule

@{
    ViewData["Title"] = "Delete Schedule";
}

<h1 class="ft-page-title">
    <i class="bi bi-trash"></i>Delete Planting Schedule
</h1>

<div class="ft-delete-card">
    <p class="ft-delete-warning">
        <i class="bi bi-exclamation-triangle-fill"></i>
        Are you sure you want to delete this planting schedule? This action cannot be undone.
    </p>
    
    <dl class="ft-detail-list">
        <dt>@Html.DisplayNameFor(model => model.Crop)</dt>
        <dd><strong>@Html.DisplayFor(model => model.Crop.Name)</strong></dd>
        
        <dt>@Html.DisplayNameFor(model => model.PlantingDate)</dt>
        <dd>@Model.PlantingDate.ToString("MMMM dd, yyyy")</dd>
        
        <dt>@Html.DisplayNameFor(model => model.OptimalPlantingDate)</dt>
        <dd>
            @if (Model.OptimalPlantingDate.HasValue)
            {
                @Model.OptimalPlantingDate.Value.ToString("MMMM dd, yyyy")
            }
            else
            {
                <span class="text-muted">—</span>
            }
        </dd>
        
        <dt>@Html.DisplayNameFor(model => model.Location)</dt>
        <dd>@(string.IsNullOrEmpty(Model.Location) ? "—" : Model.Location)</dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <div class="ft-form-actions">
            <button type="submit" class="btn btn-danger">
                <i class="bi bi-trash me-1"></i>Delete Schedule
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>Cancel
            </a>
        </div>
    </form>
</div>
