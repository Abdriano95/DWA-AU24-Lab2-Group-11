@{
    WeatherData weatherData = ViewBag.WeatherData as WeatherData;
    ViewData["Title"] = "Dashboard";
}

<!-- Hero Welcome Section -->
<h1 class="ft-hero-title">
    <i class="bi bi-flower2 me-2"></i>Welcome back, @ViewBag.FirstName!
</h1>

<!-- Dashboard Grid -->
<div class="ft-dashboard-grid">
    <!-- Weather Widget -->
    <div class="ft-widget ft-weather-widget">
        <h2 class="ft-section-title">
            <i class="bi bi-cloud-sun me-2"></i>Weather
        </h2>
        @if (weatherData != null)
        {
            var weatherEmoji = weatherData.Icon switch {
                "01d" or "01n" => "☀️",
                "02d" or "02n" => "⛅",
                "03d" or "03n" => "☁️",
                "04d" or "04n" => "☁️",
                "09d" or "09n" => "🌧️",
                "10d" or "10n" => "🌦️",
                "11d" or "11n" => "⛈️",
                "13d" or "13n" => "❄️",
                "50d" or "50n" => "🌫️",
                _ => "🌤️"
            };
            var iconUrl = $"https://openweathermap.org/img/wn/{weatherData.Icon}@@2x.png";
            <div class="ft-weather-display">
                <div class="ft-weather-icon-wrapper">
                    <span id="weather-emoji" class="ft-weather-emoji">@weatherEmoji</span>
                    <img id="weather-icon" 
                         src="@iconUrl" 
                         alt="Weather"
                         class="ft-weather-icon"
                         onload="document.getElementById('weather-emoji').style.display='none'; this.style.display='inline';"
                         onerror="this.style.display='none';">
                </div>
                <div class="ft-weather-details">
                    <div class="ft-weather-location">
                        <i class="bi bi-geo-alt me-1"></i>@weatherData.Location
                    </div>
                    <div class="ft-weather-temp">@weatherData.Temperature°C</div>
                    <div class="ft-weather-humidity">
                        <i class="bi bi-droplet me-1"></i>@weatherData.Humidity% humidity
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="ft-empty-state">
                <i class="bi bi-cloud-slash"></i>
                <p>Unable to fetch weather data</p>
            </div>
        }
    </div>

    <!-- Notifications Widget -->
    <div class="ft-widget">
        <h2 class="ft-section-title">
            <i class="bi bi-bell me-2"></i>Notifications
            @if (ViewBag.Notifications != null && ((List<DWA_AU24_Lab2_Group_11.Models.Notification>)ViewBag.Notifications).Any())
            {
                <span class="badge bg-secondary ms-2">@(((List<DWA_AU24_Lab2_Group_11.Models.Notification>)ViewBag.Notifications).Count)</span>
            }
        </h2>
        @if (ViewBag.Notifications != null && ((List<DWA_AU24_Lab2_Group_11.Models.Notification>)ViewBag.Notifications).Any())
        {
            <div class="ft-list">
                @foreach (var notification in (List<DWA_AU24_Lab2_Group_11.Models.Notification>)ViewBag.Notifications)
                {
                    <div class="ft-list-item">
                        <div class="ft-list-item-content">
                            <p class="ft-list-item-title">@notification.Message</p>
                            <p class="ft-list-item-meta">
                                <i class="bi bi-clock me-1"></i>@notification.NotificationDate.ToString("MMM dd, yyyy 'at' h:mm tt")
                            </p>
                        </div>
                        <form method="post" action="@Url.Action("MarkAsRead", "Home", new { id = notification.Id })">
                            <button type="submit" class="btn btn-sm btn-outline-info">
                                <i class="bi bi-check2 me-1"></i>Mark Read
                            </button>
                        </form>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="ft-empty-state">
                <i class="bi bi-bell-slash"></i>
                <p>No new notifications</p>
            </div>
        }
    </div>

    <!-- Tasks Widget -->
    <div class="ft-widget">
        <h2 class="ft-section-title">
            <i class="bi bi-check2-square me-2"></i>Upcoming Tasks
            @if (ViewBag.Tasks != null && ((List<DWA_AU24_Lab2_Group_11.Models.Task>)ViewBag.Tasks).Any())
            {
                <span class="badge bg-primary ms-2">@(((List<DWA_AU24_Lab2_Group_11.Models.Task>)ViewBag.Tasks).Count)</span>
            }
        </h2>
        @if (ViewBag.Tasks != null && ((List<DWA_AU24_Lab2_Group_11.Models.Task>)ViewBag.Tasks).Any())
        {
            <div class="ft-list">
                @foreach (var task in (List<DWA_AU24_Lab2_Group_11.Models.Task>)ViewBag.Tasks)
                {
                    <div class="ft-list-item">
                        <div class="ft-list-item-content">
                            <p class="ft-list-item-title">@task.TaskName</p>
                            @if (!string.IsNullOrEmpty(task.TaskDescription))
                            {
                                <p class="ft-list-item-description">@task.TaskDescription</p>
                            }
                            <p class="ft-list-item-meta">
                                <i class="bi bi-calendar-event me-1"></i>Due: @task.TaskDate.ToString("MMM dd, yyyy 'at' h:mm tt")
                            </p>
                        </div>
                        <form method="post" action="@Url.Action("MarkTaskAsCompleted", "Home", new { id = task.Id })">
                            <button type="submit" class="btn btn-sm btn-outline-success">
                                <i class="bi bi-check-lg me-1"></i>Complete
                            </button>
                        </form>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="ft-empty-state">
                <i class="bi bi-check-circle"></i>
                <p>All caught up! No pending tasks.</p>
            </div>
        }
    </div>
</div>
