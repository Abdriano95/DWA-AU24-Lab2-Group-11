<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FarmTrack</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg">
    <link rel="stylesheet" href="~/css/bootstrap-minty.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DWA_AU24_Lab2_Group_11.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark ft-navbar">
            <div class="container-fluid">
                <a class="navbar-brand ft-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-flower2 me-2"></i>FarmTrack
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" 
                        aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link ft-nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                                    <i class="bi bi-house-door me-1"></i>Home
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link ft-nav-link" asp-area="" asp-controller="Crops" asp-action="Index">
                                    <i class="bi bi-flower1 me-1"></i>Crops
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link ft-nav-link" asp-area="" asp-controller="PlantingSchedule" asp-action="Index">
                                    <i class="bi bi-calendar-event me-1"></i>Planting
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link ft-nav-link" asp-area="" asp-controller="HarvestTracking" asp-action="Index">
                                    <i class="bi bi-basket me-1"></i>Harvest
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link ft-nav-link" asp-area="" asp-controller="Task" asp-action="Index">
                                    <i class="bi bi-check2-square me-1"></i>Tasks
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link ft-nav-link" asp-area="" asp-controller="GrowthHistory" asp-action="Index">
                                    <i class="bi bi-graph-up me-1"></i>Growth
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link ft-nav-link" asp-area="" asp-controller="Admin" asp-action="Index">
                                    <i class="bi bi-shield-lock me-1"></i>Admin
                                </a>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link ft-nav-link" asp-area="Identity" asp-page="/Account/Manage/Index">
                                    <i class="bi bi-person-circle me-1"></i>My Account
                                </a>
                            </li>
                            <li class="nav-item">
                                <form asp-area="Identity" asp-page="/Account/Logout" method="post" class="d-inline">
                                    <button type="submit" class="nav-link ft-nav-link ft-logout-btn">
                                        <i class="bi bi-box-arrow-right me-1"></i>Logout
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link ft-nav-link" asp-area="Identity" asp-page="/Account/Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i>Login
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link ft-nav-link ft-register-btn" asp-area="Identity" asp-page="/Account/Register">
                                    <i class="bi bi-person-plus me-1"></i>Register
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2024-2026 - FarmTrack - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>