@model DWA_AU24_Lab2_Group_11.Models.GrowthHistory

@{
    ViewData["Title"] = "Delete Growth History";
}

<h1 class="ft-page-title">
    <i class="bi bi-trash"></i>Delete Growth History
</h1>

<div class="ft-delete-card">
    <p class="ft-delete-warning">
        <i class="bi bi-exclamation-triangle-fill"></i>
        Are you sure you want to delete this growth history record? This action cannot be undone.
    </p>
    
    <dl class="ft-detail-list">
        <dt>@Html.DisplayNameFor(model => model.PlantingSchedule)</dt>
        <dd><span class="badge bg-secondary">Schedule #@Model.PlantingSchedule?.Id</span></dd>
        
        <dt>@Html.DisplayNameFor(model => model.Notes)</dt>
        <dd>@(string.IsNullOrEmpty(Model.Notes) ? "—" : Model.Notes)</dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <div class="ft-form-actions">
            <button type="submit" class="btn btn-danger">
                <i class="bi bi-trash me-1"></i>Delete Record
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>Cancel
            </a>
        </div>
    </form>
</div>
