@model DWA_AU24_Lab2_Group_11.Models.Crop

@{
    ViewData["Title"] = "Edit Crop";
}

<h1 class="ft-page-title">
    <i class="bi bi-pencil-square"></i>Edit Crop
</h1>

<div class="ft-crud-card">
    <form asp-action="Edit" class="ft-form">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <input type="hidden" asp-for="Id" />
        
        <div class="form-group mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        
        <div class="form-group mb-3">
            <label asp-for="Type" class="form-label"></label>
            <select asp-for="Type" class="form-select" asp-items="Html.GetEnumSelectList<CropType>()"></select>
            <span asp-validation-for="Type" class="text-danger"></span>
        </div>
        
        <div class="form-group mb-3">
            <label asp-for="GrowingDurationInDays" class="form-label"></label>
            <input asp-for="GrowingDurationInDays" class="form-control" />
            <span asp-validation-for="GrowingDurationInDays" class="text-danger"></span>
        </div>
        
        <div class="ft-form-actions">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-lg me-1"></i>Save Changes
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>Cancel
            </a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
