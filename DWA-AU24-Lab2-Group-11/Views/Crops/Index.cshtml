@model IEnumerable<DWA_AU24_Lab2_Group_11.Models.Crop>

@{
    ViewData["Title"] = "Crops";
}

<div class="ft-page-header">
    <h1 class="ft-page-title">
        <i class="bi bi-flower1"></i>Crops
    </h1>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i>Add Crop
    </a>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="ft-table-container">
    @if (Model.Any())
    {
        <table class="table ft-crud-table">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(model => model.Name)</th>
                    <th>@Html.DisplayNameFor(model => model.Type)</th>
                    <th>@Html.DisplayNameFor(model => model.GrowingDurationInDays)</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@Html.DisplayFor(modelItem => item.Name)</strong></td>
                        <td>
                            <span class="badge bg-success">@Html.DisplayFor(modelItem => item.Type)</span>
                        </td>
                        <td>@Html.DisplayFor(modelItem => item.GrowingDurationInDays) days</td>
                        <td>
                            <div class="ft-table-actions">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info btn-sm" title="View Details">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning btn-sm" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="ft-table-empty">
            <i class="bi bi-inbox"></i>
            <p>No crops found. Add your first crop to get started!</p>
            <a asp-action="Create" class="btn btn-primary mt-2">
                <i class="bi bi-plus-lg me-1"></i>Add Crop
            </a>
        </div>
    }
</div>