@model DWA_AU24_Lab2_Group_11.Models.Crop

@{
    ViewData["Title"] = "Crop Details";
}

<h1 class="ft-page-title">
    <i class="bi bi-flower1"></i>Crop Details
</h1>

<div class="ft-crud-card">
    <dl class="ft-detail-list">
        <dt>@Html.DisplayNameFor(model => model.Name)</dt>
        <dd>@Html.DisplayFor(model => model.Name)</dd>
        
        <dt>@Html.DisplayNameFor(model => model.Type)</dt>
        <dd><span class="badge bg-success">@Html.DisplayFor(model => model.Type)</span></dd>
        
        <dt>@Html.DisplayNameFor(model => model.GrowingDurationInDays)</dt>
        <dd>@Html.DisplayFor(model => model.GrowingDurationInDays) days</dd>
    </dl>
    
    <div class="ft-form-actions">
        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning">
            <i class="bi bi-pencil me-1"></i>Edit
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Back to List
        </a>
    </div>
</div>
