@model IEnumerable<DWA_AU24_Lab2_Group_11.Models.Task>

@{
    ViewData["Title"] = "Tasks";
}

<div class="ft-page-header">
    <h1 class="ft-page-title">
        <i class="bi bi-check2-square"></i>Tasks
    </h1>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i>Add Task
    </a>
</div>

<div class="ft-table-container">
    @if (Model.Any())
    {
        <table class="table ft-crud-table">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(model => model.TaskName)</th>
                    <th>@Html.DisplayNameFor(model => model.TaskDate)</th>
                    <th>Status</th>
                    <th>Schedule</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <strong>@Html.DisplayFor(modelItem => item.TaskName)</strong>
                            @if (!string.IsNullOrEmpty(item.TaskDescription))
                            {
                                <br /><small class="text-muted">@item.TaskDescription</small>
                            }
                        </td>
                        <td>@item.TaskDate.ToString("MMM dd, yyyy")</td>
                        <td>
                            @if (item.IsCompleted)
                            {
                                <span class="badge bg-success"><i class="bi bi-check-lg me-1"></i>Completed</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark"><i class="bi bi-clock me-1"></i>Pending</span>
                            }
                        </td>
                        <td>
                            @if (item.PlantingSchedule != null)
                            {
                                <span class="badge bg-info">Schedule #@item.PlantingSchedule.Id</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>
                            <div class="ft-table-actions">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info btn-sm" title="View Details">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning btn-sm" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="ft-table-empty">
            <i class="bi bi-clipboard-check"></i>
            <p>No tasks found. Create your first task to get started!</p>
            <a asp-action="Create" class="btn btn-primary mt-2">
                <i class="bi bi-plus-lg me-1"></i>Add Task
            </a>
        </div>
    }
</div>
