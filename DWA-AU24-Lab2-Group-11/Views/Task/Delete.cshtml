@model DWA_AU24_Lab2_Group_11.Models.Task

@{
    ViewData["Title"] = "Delete Task";
}

<h1 class="ft-page-title">
    <i class="bi bi-trash"></i>Delete Task
</h1>

<div class="ft-delete-card">
    <p class="ft-delete-warning">
        <i class="bi bi-exclamation-triangle-fill"></i>
        Are you sure you want to delete this task? This action cannot be undone.
    </p>
    
    <dl class="ft-detail-list">
        <dt>@Html.DisplayNameFor(model => model.TaskName)</dt>
        <dd>@Html.DisplayFor(model => model.TaskName)</dd>
        
        <dt>@Html.DisplayNameFor(model => model.TaskDescription)</dt>
        <dd>@(string.IsNullOrEmpty(Model.TaskDescription) ? "—" : Model.TaskDescription)</dd>
        
        <dt>@Html.DisplayNameFor(model => model.TaskDate)</dt>
        <dd>@Model.TaskDate.ToString("MMMM dd, yyyy 'at' h:mm tt")</dd>
        
        <dt>Status</dt>
        <dd>
            @if (Model.IsCompleted)
            {
                <span class="badge bg-success">Completed</span>
            }
            else
            {
                <span class="badge bg-warning text-dark">Pending</span>
            }
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <div class="ft-form-actions">
            <button type="submit" class="btn btn-danger">
                <i class="bi bi-trash me-1"></i>Delete Task
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>Cancel
            </a>
        </div>
    </form>
</div>
