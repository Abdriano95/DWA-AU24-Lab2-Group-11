@model DWA_AU24_Lab2_Group_11.Models.Task

@{
    ViewData["Title"] = "Edit Task";
}

<h1 class="ft-page-title">
    <i class="bi bi-pencil-square"></i>Edit Task
</h1>

<div class="ft-crud-card">
    <form asp-action="Edit" class="ft-form">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <input type="hidden" asp-for="Id" />
        
        <div class="form-group mb-3">
            <label asp-for="TaskName" class="form-label"></label>
            <input asp-for="TaskName" class="form-control" />
            <span asp-validation-for="TaskName" class="text-danger"></span>
        </div>
        
        <div class="form-group mb-3">
            <label asp-for="TaskDescription" class="form-label"></label>
            <textarea asp-for="TaskDescription" class="form-control" rows="3"></textarea>
            <span asp-validation-for="TaskDescription" class="text-danger"></span>
        </div>
        
        <div class="form-group mb-3">
            <label asp-for="TaskDate" class="form-label"></label>
            <input asp-for="TaskDate" class="form-control" type="datetime-local" />
            <span asp-validation-for="TaskDate" class="text-danger"></span>
        </div>
        
        <div class="form-group mb-3 form-check">
            <input class="form-check-input" asp-for="IsCompleted" />
            <label class="form-check-label" asp-for="IsCompleted">@Html.DisplayNameFor(model => model.IsCompleted)</label>
        </div>
        
        <div class="form-group mb-3">
            <label asp-for="PlantingScheduleId" class="form-label"></label>
            <select asp-for="PlantingScheduleId" class="form-select" asp-items="ViewBag.PlantingScheduleId">
                <option value="">-- Select Schedule (Optional) --</option>
            </select>
            <span asp-validation-for="PlantingScheduleId" class="text-danger"></span>
        </div>
        
        <div class="ft-form-actions">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-lg me-1"></i>Save Changes
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>Cancel
            </a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
